@page
@model ApproveExpensesModel
@{
    ViewData["Title"] = "Approve Expenses";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">Approve Expenses</h3>
        </div>
        <div class="card-body">
            <h5>Pending expenses:</h5>
            
            @if (Model.PendingExpenses != null && Model.PendingExpenses.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Category</th>
                                <th>Amount</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var expense in Model.PendingExpenses)
                            {
                                <tr>
                                    <td>@expense.ExpenseDate.ToString("dd/MM/yyyy")</td>
                                    <td>@expense.CategoryName</td>
                                    <td>£@expense.AmountGBP.ToString("N2")</td>
                                    <td>
                                        <form method="post" class="d-inline">
                                            <input type="hidden" name="expenseId" value="@expense.ExpenseId" />
                                            <button type="submit" asp-page-handler="Approve" class="btn btn-success btn-sm">Approve</button>
                                            <button type="submit" asp-page-handler="Reject" class="btn btn-danger btn-sm">Reject</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted">No pending expenses.</p>
            }
            
            <div class="mt-3">
                <a asp-page="/Index" class="btn btn-secondary">Back to Expenses</a>
            </div>
        </div>
    </div>
</div>
